# Entornos virtuales
.venv/
venv/
env/
ENV/
**/venv/
**/.venv/

# Caché de Python
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.Python

# Distribución / empaquetado
**/dist/
**/build/
**/*.egg-info/
**/*.egg
**/wheels/
**/.eggs/

